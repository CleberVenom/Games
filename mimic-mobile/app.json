{
  "expo": {
    "name": "Mimic Mobile",
    "slug": "cleber-santarosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mimicmobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C1D",
    "ios": {
      "bundleIdentifier": "com.mimicmobile.app"
    },
    "android": {
      "package": "com.mimicmobile.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "iosMicrophonePermission": "O Mimic Mobile usa o microfone para gravar as suas imitações e para o chat de voz com os amigos nas salas online."
        }
      ],
      "expo-asset",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "O Mimic Mobile usa o microfone para gravar as suas imitações e para o chat de voz com os amigos nas salas online.",
          "cameraPermission": "O Mimic Mobile não usa a câmera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c97490be-bb95-418b-9124-bea84ec6cb4b"
      }
    },
    "owner": "v3-app"
  }
}
