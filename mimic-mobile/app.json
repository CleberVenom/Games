{
  "expo": {
    "name": "Imitashow",
    "slug": "cleber-santarosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imitashow",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2E093C",
    "ios": {
      "bundleIdentifier": "com.mimicmobile.app"
    },
    "android": {
      "package": "com.mimicmobile.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E093C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E093C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168
        }
      ],
      "expo-font",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "iosMicrophonePermission": "O Imitashow usa o microfone para gravar as suas imitações e para o chat de voz com os amigos nas salas online."
        }
      ],
      "expo-asset",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "O Imitashow usa o microfone para gravar as suas imitações e para o chat de voz com os amigos nas salas online.",
          "cameraPermission": "O Imitashow não usa a câmera."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c97490be-bb95-418b-9124-bea84ec6cb4b"
      }
    },
    "owner": "v3-app",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c97490be-bb95-418b-9124-bea84ec6cb4b",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
